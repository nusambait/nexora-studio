{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run NEXORA Studio",
            "type": "cargo",
            "command": "run",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build NEXORA Studio (Release)",
            "type": "cargo",
            "command": "build",
            "args": ["--release"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Test NEXORA Studio",
            "type": "cargo",
            "command": "test",
            "problemMatcher": ["$rustc"]
        }
    ]
}

